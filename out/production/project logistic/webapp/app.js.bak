const ResetViewControl =
    L.Control.extend({

        options: {
            position:
                "topright"
        },

        onAdd: function () {

            const container =
                L.DomUtil.create(
                    "div",
                    "leaflet-control reset-view-control"
                );


            const button =
                L.DomUtil.create(
                    "button",
                    "reset-view-button",
                    container
                );


            button.type =
                "button";


            button.innerHTML =
                "⌖";


            button.title =
                "Center map";


            L.DomEvent.disableClickPropagation(
                container
            );


            L.DomEvent.on(
                button,
                "click",
                event => {

                    L.DomEvent.stop(
                        event
                    );


                    if (
                        appState?.loaded
                    ) {

                        fitMapToGraph(
                            appState
                        );

                    }

                    else {

                        map.setView(
                            [
                                7.0100,
                                100.4700
                            ],
                            13
                        );

                    }

                }
            );


            return container;
        }

    });


map.addControl(
