/* ============================================================
   API
============================================================ */

async function getJson(
    url
) {

    const response =
        await fetch(url);


    if (!response.ok) {

        throw new Error(
            `HTTP ${response.status}`
        );

    }


    return response.json();
}


async function postJson(
    url,
    data = {}
) {

    const response =
        await fetch(
            url,
            {
                method:
                    "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body:
                    JSON.stringify(
                        data
                    )
            }
        );


    if (!response.ok) {

        throw new Error(
            `HTTP ${response.status}`
        );

    }


    return response.json();
}


/* ============================================================
   SYNC
============================================================ */

syncBtn.addEventListener(
    "click",
    async () => {

        syncBtn.classList.add(
            "syncing"
        );


        try {

            const state =
                await getJson(
                    API.STATE
                );


            if (
                !state ||
                !state.loaded
            ) {

                throw new Error(
                    "No state"
                );

            }


            appState =
                state;


            restoreSelectedNodes(
                state
            );


            renderState(
                state,
                false
            );


            updateMapLoadedStatus();

            updateRouteButton();


            showToast(
                t("syncSuccess"),
                "success"
            );

        }

        catch (error) {

            console.error(
                error
            );


            showToast(
                t("syncFailed"),
                "error"
            );

        }

        finally {

            setTimeout(
                () => {

                    syncBtn.classList.remove(
                        "syncing"
                    );

                },
                350
            );

        }

    }
);


